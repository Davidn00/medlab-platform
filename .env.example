APP_NAME=MedLab Platform
APP_VERSION=1.0.0
ENVIRONMENT=development

SECRET_KEY=change_this_secret_key
ACCESS_TOKEN_EXPIRE_MINUTES=30

POSTGRES_DB=medlab
POSTGRES_USER=medlab_user
POSTGRES_PASSWORD=change_me

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Reports
REPORTS_DIR=/app/reports


ADMIN_EMAIL=admin@medlab.com
ADMIN_PASSWORD=change-me
ADMIN_FULL_NAME=Administrador MedLab

DATABASE_URL=postgresql+psycopg://medlab_user:change_me@postgres:5432/medlab

# Celery - fault tolerance
CELERY_TASK_MAX_RETRIES=5
CELERY_TASK_RETRY_BACKOFF=10
CELERY_TASK_RETRY_BACKOFF_MAX=300
CELERY_TASK_RETRY_JITTER=true

# ==========================================================
# Security
# ==========================================================

JWT_ISSUER=medlab-platform

# Separar múltiples valores con coma
CORS_ORIGINS=http://localhost:3000

ALLOWED_HOSTS=localhost,127.0.0.1

ENABLE_DOCS=true

# Login rate limiting
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=60

# Redis production
REDIS_PASSWORD=